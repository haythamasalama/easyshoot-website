---
import "../styles/home.css";
import { APP_STORE_URL, LANGS, LANG_NAMES, dirOf, privacyPath, useT, tabsFor, shotAlts, type Lang } from "../i18n";
import data from "../i18n/data.json";
import { edHTML, inspectorPanelHTML, shotHTML, stylePanelHTML } from "../lib/editor";
import { dashHTML } from "../lib/dash";
import { flowArt, moreArt } from "../lib/flow";
import AppleLogo from "./AppleLogo.astro";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const TABS = tabsFor(lang);
const ALT = shotAlts(lang);
const ED = (data.ed as Record<string, Record<string, string>>)[lang];
const UI = data.ui as Record<string, Record<string, string>>;
const storeHref = APP_STORE_URL || "#get";

const STEPS = [
  { mode: "mark", ...TABS[0] },
  { mode: "shape", ...TABS[1] },
  { mode: "pixel", ...TABS[2] },
];
const KEYED = [["A", "t.arrow"], ["R", "t.rect"], ["D", "t.diamond"], ["O", "t.ellipse"], ["N", "t.counter"], ["T", "t.text"], ["P", "t.pen"], ["B", "t.pixel"], ["C", "t.crop"]];
const NOTES = [
  { id: "fill", title: ED.bg, side: "a" }, { id: "stroke", title: ED.stroke, side: "a" }, { id: "width", title: ED.strokeW, side: "a" },
  { id: "style", title: ED.strokeS, side: "b" }, { id: "edges", title: ED.corners, side: "b" }, { id: "opacity", title: ED.opacity, side: "b" },
];
const NOTE_ICONS: Record<string, string> = {
  stroke: '<circle cx="12" cy="12" r="7" stroke-width="2.4"/>',
  fill: '<rect x="5" y="5" width="14" height="14" rx="3" fill="currentColor" fill-opacity=".35"/><rect x="5" y="5" width="14" height="14" rx="3"/>',
  width: '<path d="M5 7h14" stroke-width="1.2"/><path d="M5 12h14" stroke-width="2.2"/><path d="M5 17.5h14" stroke-width="3.4"/>',
  style: '<path d="M4 12h3M10.5 12h3M17 12h3" stroke-width="2.2"/>',
  edges: '<path d="M6 19V11a5 5 0 0 1 5-5h8" stroke-width="2"/>',
  opacity: '<circle cx="12" cy="12" r="7"/><path d="M12 5a7 7 0 0 1 0 14Z" fill="currentColor" stroke="none"/>',
};
const noteIcon = (id: string) => `<span class="note-ic" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${NOTE_ICONS[id]}</svg></span>`;
const noteHTML = (n: (typeof NOTES)[number]) => `<p class="note" data-note="${n.id}">${noteIcon(n.id)}<span><b>${n.title}</b>${t(`note.${n.id}`)}</span></p>`;
const art = flowArt(lang);
const more = moreArt(lang);
const firstLang = lang;
const langOrder = [firstLang, ...LANGS.filter(l => l !== firstLang)];
const bigLine = (l: Lang) => UI[l]["ar.big"].split("<small>")[0];
---
<main id="top">

<section class="hero">
  <div class="sky hero-sky">
    <div class="hero-head">
      <img class="hero-icon rise" src="/icon-256.png" width="84" height="84" alt={t("icon.alt")} fetchpriority="high">
      <h1 class="rise">{t("hero.title")}</h1>
      <p class="hero-lead rise">{t("hero.lead")}</p>
      <div class="hero-act rise">
        <a class="btn btn-store" href={storeHref}><AppleLogo />{t("hero.cta")}</a>
        <p>{t("hero.meta")}</p>
      </div>
    </div>
    <div class="hero-win rise" data-ui>
      <div class="ed m-mark" role="img" aria-label={t("hero.alt")} set:html={edHTML("mark", lang)} />
    </div>
  </div>
</section>

<section class="flow" id="features">
  <div class="sec-head">
    <p class="eyebrow rise">{t("eye.flow")}</p>
    <h2 class="h2 rise">{t("flow.head")}</h2>
  </div>
  <div class="flow-grid">
    <article class="rise"><div class="sky tile-art" data-ui aria-hidden="true" set:html={art.select} /><h3>{t("flow.1t")}</h3><p>{t("flow.1b")}</p></article>
    <article class="rise"><div class="sky tile-art" data-ui set:html={art.quick} /><h3>{t("flow.2t")}</h3><p>{t("flow.2b")}</p></article>
    <article class="rise"><div class="sky tile-art" data-ui set:html={art.mark} /><h3>{t("tab.mark")}</h3><p>{t("flow.mb")}</p></article>
    <article class="rise"><div class="sky tile-art" data-ui set:html={art.share} /><h3>{t("flow.3t")}</h3><p>{t("flow.3b")}</p></article>
  </div>
</section>

<section class="pin" id="tools">
  <div class="pin-words">
    <div class="pin-intro">
      <p class="eyebrow rise">{t("eye.tools")}</p>
      <h2 class="h2 rise" set:html={t("tools.title")} />
      <p class="rise">{t("tools.sub")}</p>
      <ul class="keyset rise">{KEYED.map(([k, l]) => <li><kbd>{k}</kbd>{t(l)}</li>)}</ul>
    </div>
    {STEPS.map((s, i) => (
      <article class="pin-step" data-step={i}>
        <h3>{s.t}</h3>
        <p>{s.b}</p>
      </article>
    ))}
  </div>
  <div class="pin-stage" data-ui>
    {STEPS.map((s, i) => (
      <figure class={`sky feat-art pin-win${i === 0 ? " on" : ""}`} data-controls data-nosnippet>
        <figcaption class="sr-only">{ALT[i]}</figcaption>
        <div class={`ed m-${s.mode}`} set:html={edHTML(s.mode, lang, { shot: dashHTML(lang), live: true })} />
      </figure>
    ))}
  </div>
</section>

<section class="twin" aria-labelledby="twin-h">
  <div class="sec-head">
    <p class="eyebrow rise">{t("eye.twin")}</p>
    <h2 class="h2 rise" id="twin-h">{TABS[3].t}</h2>
    <p class="rise">{TABS[3].b}</p>
  </div>
  <div class="twin-row">
    <div class="twin-in" data-ui data-controls data-target=".bg-out"><div class="ed ed-solo" set:html={inspectorPanelHTML("bg", lang)} /></div>
    <div class="twin-out" data-ui><div class="bg-out" data-nosnippet set:html={shotHTML("bg", lang)} /></div>
  </div>
</section>

<section class="plate" aria-labelledby="plate-h">
  <div class="sec-head">
    <p class="eyebrow rise">{t("eye.plate")}</p>
    <h2 class="h2 rise" id="plate-h">{t("style.t")}</h2>
    <p class="rise">{t("style.b")}</p>
  </div>
  <div class="plate-row">
    <div class="plate-side a"><Fragment set:html={NOTES.filter(n => n.side === "a").map(noteHTML).join("")} /></div>
    <div class="plate-panel" data-ui data-controls><div class="ed ed-solo" set:html={stylePanelHTML(lang)} /></div>
    <div class="plate-side b"><Fragment set:html={NOTES.filter(n => n.side === "b").map(noteHTML).join("")} /></div>
  </div>
</section>

<section class="more" aria-labelledby="more-h">
  <div class="sec-head">
    <p class="eyebrow rise">{t("eye.more")}</p>
    <h2 class="h2 rise" id="more-h">{t("more.title")}</h2>
  </div>
  <div class="more-grid">
    <article class="rise m4"><div class="sky more-art" data-ui aria-hidden="true" set:html={more.presets} /><h3>{t("preset.t")}</h3><p>{t("preset.b")}</p></article>
    <article class="rise m2"><div class="sky more-art" data-ui aria-hidden="true" set:html={more.crop} /><h3>{t("crop.t")}</h3><p>{t("crop.b")}</p></article>
    <article class="rise m2"><div class="sky more-art" data-ui aria-hidden="true" set:html={more.zoom} /><h3>{t("zoom.t")}</h3><p>{t("zoom.b")}</p></article>
    <article class="rise m4"><div class="more-art plain" data-ui aria-hidden="true" set:html={more.keys} /><h3>{t("sc.t")}</h3><p>{t("sc.b")}</p></article>
    <article class="rise m3"><div class="more-art plain" data-ui aria-hidden="true" set:html={more.formats} /><h3>{t("fmt.t")}</h3><p>{t("fmt.b")}</p></article>
    <article class="rise m3"><div class="more-art" data-ui aria-hidden="true" set:html={more.theme} /><h3>{t("ap.t")}</h3><p>{t("ap.b")}</p></article>
  </div>
</section>

<section class="tongues" aria-labelledby="tongues-h">
  <div class="sec-head">
    <p class="eyebrow rise">{t("eye.tongues")}</p>
    <h2 class="h2 rise" id="tongues-h">{t("ar.title")}</h2>
    <p class="rise">{t("ar.sub")}</p>
  </div>
  <div class="tongues-names rise" role="group" aria-labelledby="tongues-h">
    {langOrder.map((l, i) => <button type="button" lang={l} data-show={l} aria-pressed={i === 0 ? "true" : "false"}>{LANG_NAMES[l as Lang]}</button>)}
  </div>
  <div class="tongues-stage">
    {langOrder.map((l, i) => (
      <div class={`tongue${i === 0 ? " on" : ""}`} data-lang={l} lang={l} dir={dirOf(l as Lang)}>
        <p class="tongue-line" set:html={bigLine(l as Lang)} />
        <div class="tongue-shot m-mark" data-ui data-nosnippet aria-hidden="true"><Fragment set:html={shotHTML("mark", l as Lang)} /></div>
      </div>
    ))}
  </div>
</section>

<section class="promise" id="privacy">
  <div class="sky promise-art" aria-hidden="true">
    <svg viewBox="0 0 320 320" fill="none">
      <g stroke="#FFFFFF" stroke-width="16" stroke-linecap="round">
        <path d="M40 92V62a22 22 0 0 1 22-22h30"/><path d="M228 40h30a22 22 0 0 1 22 22v30"/><path d="M280 228v30a22 22 0 0 1-22 22h-30"/><path d="M92 280H62a22 22 0 0 1-22-22v-30"/>
      </g>
      <path d="M124 152v-24a36 36 0 0 1 72 0v24" stroke="#FFFFFF" stroke-width="14" stroke-linecap="round"/>
      <rect x="104" y="148" width="112" height="84" rx="22" fill="#FFFFFF"/>
      <circle cx="160" cy="184" r="11" fill="#1A63D6"/><path d="M160 190v18" stroke="#1A63D6" stroke-width="8" stroke-linecap="round"/>
    </svg>
  </div>
  <div class="promise-body">
    <p class="eyebrow rise">{t("eye.priv")}</p>
    <h2 class="h2 rise">{t("priv.title")}</h2>
    <p class="rise">{t("priv.sub")}</p>
    <div class="priv-cards">
      <div class="priv-card rise">
        <h3>{t("priv.localT")}</h3>
        <ul>{[1, 2, 3].map(i => <li><b>{t(`p.${i}t`)}.</b> {t(`p.${i}b`)}</li>)}</ul>
      </div>
      <div class="priv-card rise">
        <h3>{t("priv.netT")}</h3>
        <ul>{[1, 2, 3].map(i => <li><b>{t(`priv.n${i}t`)}</b> {t(`priv.n${i}b`)}</li>)}</ul>
      </div>
    </div>
    <a class="btn btn-line rise" href={privacyPath(lang)}>{t("priv.link")}</a>
  </div>
</section>

<section class="ask" id="faq">
  <div class="ask-h">
    <p class="eyebrow rise">{t("eye.faq")}</p>
    <h2 class="h2">{t("faq.title")}</h2>
  </div>
  <div class="faq" id="faq-list">
    {[1, 2, 3, 4, 5].map(i => <details class="rise" name="faq" open={i === 1}><summary>{t(`q.${i}`)}</summary><p>{t(`a.${i}`)}</p></details>)}
  </div>
</section>

<section class="close" id="get">
  <div class="sky close-sky">
    <img class="rise" src="/icon-256.png" width="84" height="84" alt="" loading="lazy">
    <h2 class="h2 rise">{t("final.title")}</h2>
    <a class="btn btn-store rise" href={storeHref}><AppleLogo />{t("hero.cta")}</a>
    <p class="rise">{t("hero.meta")}</p>
  </div>
</section>
</main>
