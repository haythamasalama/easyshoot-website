---
import { LANGS, LANG_NAMES, APP_STORE_URL, SUPPORT_EMAIL, TERMS_URL, X_URL, AUTHOR_URL, pagePath, privacyPath, supportPath, accessibilityPath, useT, type Lang } from "../i18n";
import { GUIDES, COMPARES, articlePath } from "../i18n/articles";
import AppleLogo from "./AppleLogo.astro";
import signature from "../assets/haythamasalama-signature.svg?raw";

interface Props { lang: Lang; alternates: Record<Lang, string> }
const { lang, alternates } = Astro.props;
const t = useT(lang);
const home = pagePath(lang);
const storeHref = APP_STORE_URL || home + "#get";
const privacyHref = privacyPath(lang);
const supportHref = supportPath(lang);
---


<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="es-mark" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"/></g><circle cx="12" cy="12" r="3.6" fill="currentColor"/></symbol>
</svg>

<header class="top">
  <div class="nav">
    <a class="brand wm" href={pagePath(lang)} dir="ltr"><img src="/icon.png" width="30" height="30" alt=""><span>Easy<span class="s">Shoot</span></span></a>
    <nav class="links">
      <a href={home + "#features"}>{t("nav.features")}</a>
      <a href={home + "#tools"}>{t("nav.tools")}</a>
      <a href={home + "#privacy"}>{t("nav.privacy")}</a>
      <details class="nav-more">
        <summary>{t("nav.resources")}<svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.5 5 6.5l3-3"/></svg></summary>
        <ul class="lang-menu">
          <li><a href={home + "docs/"}>{t("nav.docs")}</a></li>
          <li><a href={home + "#faq"}>{t("foot.faq")}</a></li>
          <li><a href={home + "guides/"}>{t("foot.guides")}</a></li>
          <li><a href={home + "compare/"}>{t("foot.compare")}</a></li>
          <li><a href={home + "changelog/"}>{t("foot.changelog")}</a></li>
        </ul>
      </details>
    </nav>
    <div class="tools">
      <a class="btn btn-store" href={storeHref}><AppleLogo />{t("hero.cta")}</a>
    </div>
  </div>
</header>

<slot />

<footer class="site-foot">
  <div class="foot-in">
    <div class="foot-head">
      <div class="foot-brand">
        <a class="brand wm" href={pagePath(lang)} dir="ltr"><img src="/icon.png" width="30" height="30" alt="" loading="lazy"><span>Easy<span class="s">Shoot</span></span></a>
        <p>{t("foot.about")}</p>
      </div>
      <a class="btn btn-store" href={storeHref}><AppleLogo />{t("hero.cta")}</a>
    </div>
      <nav class="foot-cols" aria-label={t("foot.product")}>
        <div><h2>{t("foot.product")}</h2><ul><li><a href={home + "#features"}>{t("nav.features")}</a></li><li><a href={home + "#tools"}>{t("nav.tools")}</a></li><li><a href={home + "#faq"}>{t("foot.faq")}</a></li></ul></div>
        <div><h2>{t("foot.guides")}</h2><ul>{GUIDES.map(a => <li><a href={articlePath(lang, a)}>{a.short[lang]}</a></li>)}</ul></div>
        <div><h2>{t("foot.compare")}</h2><ul>{COMPARES.map(a => <li><a href={articlePath(lang, a)}>{a.short[lang]}</a></li>)}</ul></div>
        <div><h2>{t("foot.help")}</h2><ul><li><a href={home + "docs/"}>{t("nav.docs")}</a></li><li><a href={supportHref}>{t("foot.support")}</a></li><li><a href={home + "changelog/"}>{t("foot.changelog")}</a></li><li><a href={home + "press/"}>{t("foot.press")}</a></li><li><a href={home + "sitemap/"}>{t("map.title")}</a></li></ul></div>
      </nav>
    <div class="foot-row">
      <p>{t("foot.ask")} <a href={`mailto:${SUPPORT_EMAIL}`} dir="ltr">{SUPPORT_EMAIL}</a>.</p>
      <div class="foot-end">
      <div class="theme-pick" role="group" aria-label={t("theme.label")}>
        <button type="button" data-theme-choice="system" aria-pressed="true" title={t("theme.system")} aria-label={t("theme.system")}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg></button>
        <button type="button" data-theme-choice="light" aria-pressed="false" title={t("theme.light")} aria-label={t("theme.light")}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
        <button type="button" data-theme-choice="dark" aria-pressed="false" title={t("theme.dark")} aria-label={t("theme.dark")}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></button>
      </div>
      <details class="lang foot-lang">
        <summary class="chip-btn" aria-label={t("lang.label")}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>
          <span>{LANG_NAMES[lang]}</span>
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6.5 5 3.5l3 3"/></svg>
        </summary>
        <ul class="lang-menu">
          {LANGS.map(l => <li><a href={alternates[l] ?? pagePath(l)} hreflang={l} lang={l} aria-current={l === lang ? "page" : undefined}>{LANG_NAMES[l]} <small>{l.toUpperCase()}</small></a></li>)}
        </ul>
      </details>
      </div>
    </div>
    <div class="foot-row">
      <p set:html={t("foot.copy")} />
      <nav class="foot-legal" aria-label={t("foot.help")}>
        <a href={privacyHref}>{t("foot.privacy")}</a>
        <a href={accessibilityPath(lang)}>{t("foot.accessibility")}</a>
        <a href={TERMS_URL} rel="noopener">{t("foot.terms")}</a>
        <span class="foot-icons">
          <a class="foot-icon" href={X_URL} rel="me noopener" aria-label="X" title="X"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.77L17.75 3Zm-1.08 16.2h1.7L7.4 4.73H5.58L16.67 19.2Z"/></svg></a>
          <a class="foot-sig" href={AUTHOR_URL} rel="author noopener" aria-label="Haytham A. Salama" title="Haytham A. Salama" set:html={signature} />
        </span>
      </nav>
    </div>
  </div>
</footer>
