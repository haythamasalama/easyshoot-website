---
import Base from "../layouts/Base.astro";
import { SITE, pagePath, type Lang } from "../i18n";
import { LEGAL } from "../i18n/legal";
import { breadcrumbNode } from "../lib/seo";

interface Props { lang: "en" | "ar"; page: "privacy" | "support" | "accessibility" }
const { lang, page } = Astro.props;
const p = LEGAL[lang][page];
const path = (l: "en" | "ar") => (l === "ar" ? `/ar/${page}.html` : `/${page}.html`);
const alternates = { en: path("en"), ar: path("ar") } as Record<Lang, string>;
const url = SITE + path(lang);
const graph = [
  breadcrumbNode(url, [{ name: "EasyShoot", path: pagePath(lang) }, { name: p.h1, path: path(lang) }]),
  ...(page === "support"
    ? [{ "@type": "FAQPage", "@id": `${url}#faq`, inLanguage: lang, mainEntity: p.sections.filter(s => s.h2.endsWith("?") || s.h2.endsWith("؟")).map(s => ({ "@type": "Question", name: s.h2, acceptedAnswer: { "@type": "Answer", text: s.html.replace(/<[^>]+>/g, "") } })) }]
    : []),
];
const ICONS: Record<string, string> = {
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6M3 3l18 18"/>',
  cloud: '<path d="M7 18a5 5 0 0 1-.5-10A6 6 0 0 1 18 9a4.5 4.5 0 0 1-.5 9z"/><path d="M3 3l18 18"/>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/><path d="M3 3l18 18"/>',
  font: '<path d="M4 20l6-16h4l6 16M7 14h10"/>',
  mac: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  moon: '<path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/>',
  shapes: '<circle cx="8" cy="8" r="4.5"/><rect x="12" y="12" width="8.5" height="8.5" rx="1.5"/>',
  contrast: '<circle cx="12" cy="12" r="9"/><path d="M12 3v18"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/>',
  keyboard: '<rect x="2.5" y="6" width="19" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10"/>',
};
---
<Base lang={lang} title={p.title} description={p.description} alternates={alternates} graph={graph}>
<main class="doc legal">
  <div class="wrap doc-layout">
    <div class="doc-main">
      <nav class="crumbs reveal" aria-label="Breadcrumb">
        <ol><li><a href={pagePath(lang)}>EasyShoot</a></li><li><span aria-current="page">{p.h1}</span></li></ol>
      </nav>
      <header class="doc-head reveal">
        <h1>{p.h1}</h1>
        <p class="doc-lead" set:html={p.lead} />
        {p.date && <p class="doc-meta"><span class="pill-tag">{p.date}</span></p>}
      </header>
      {p.summary && (
        <ul class={`legal-summary n${p.summary.length} reveal`}>
          {p.summary.map(s => (
            <li>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[s.icon]} />
              <strong>{s.t}</strong>
              <span dir={s.b.includes("@") ? "ltr" : undefined}>{s.b}</span>
            </li>
          ))}
        </ul>
      )}
      {p.sections.map(s => (
        <section class="doc-section reveal" id={s.id} aria-labelledby={`${s.id}-h`}>
          <h2 id={`${s.id}-h`}><a class="anchor" href={`#${s.id}`} aria-hidden="true">#</a>{s.h2}</h2>
          <div class="prose" set:html={s.html} />
        </section>
      ))}
    </div>
    <aside class="doc-toc" aria-label={p.toc}>
      <p>{p.toc}</p>
      <ol>{p.sections.map(s => <li><a href={`#${s.id}`}>{s.h2}</a></li>)}</ol>
    </aside>
  </div>
</main>
</Base>
