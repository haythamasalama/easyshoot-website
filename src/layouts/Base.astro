---
import "../styles/global.css";
import "../styles/drawn.css";
import Chrome from "../components/Chrome.astro";
import { SITE, LANGS, OG_LOCALE, AUTHOR_URL, dirOf, type Lang } from "../i18n";
import { authorNode } from "../lib/seo";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternates: Record<Lang, string>;
  graph?: object[];
  ogType?: string;
  meta?: { property: string; content: string }[];
  notFound?: boolean;
}
const { lang, title, description, alternates, graph = [], ogType = "website", meta = [], notFound = false } = Astro.props;
const url = SITE + alternates[lang];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${SITE}/#site`, name: "EasyShoot", alternateName: ["EasyShoot for Mac", "EasyShoot: Screenshot & Markup"], url: `${SITE}/`, inLanguage: [...LANGS], publisher: { "@id": `${AUTHOR_URL}/#person` } },
    authorNode,
    ...(notFound ? [] : [{ "@type": "WebPage", "@id": `${url}#page`, url, name: title, description, inLanguage: lang, isPartOf: { "@id": `${SITE}/#site` }, about: { "@id": `${SITE}/#app` } }]),
    ...graph,
  ],
};
---
<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={notFound ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"}>
<meta name="application-name" content="EasyShoot">
{!notFound && <link rel="canonical" href={url}>}
{!notFound && LANGS.filter(l => alternates[l]).map(l => <link rel="alternate" hreflang={l} href={SITE + alternates[l]}>)}
{!notFound && <link rel="alternate" hreflang="x-default" href={SITE + alternates.en}>}
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly summary">
<link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full documentation as plain text">
<link rel="sitemap" href="/sitemap-index.xml">
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="EasyShoot">
<meta property="og:locale" content={OG_LOCALE[lang]}>
{LANGS.filter(l => l !== lang && alternates[l]).map(l => <meta property="og:locale:alternate" content={OG_LOCALE[l]}>)}
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={`${SITE}/og.png`}>
{meta.map(m => <meta property={m.property} content={m.content}>)}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={title}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@haythamasalama">
<meta name="twitter:creator" content="@haythamasalama">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`${SITE}/og.png`}>
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0A0A0B" media="(prefers-color-scheme: dark)">
<link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
{lang === "ar" && <link rel="preload" href="/fonts/ibm-plex-sans-arabic-400.woff2" as="font" type="font/woff2" crossorigin>}
{Astro.url.pathname === "/" && (
<script is:inline>
  // First visit to the English home: open the page in the browser's own language if the site has it.
  // A language picked from the menu is remembered and always wins.
  try {
    var saved = localStorage.getItem("easyshoot-lang");
    var want = saved || ((navigator.languages && navigator.languages[0]) || navigator.language || "en").slice(0, 2).toLowerCase();
    if (["ar", "fr", "es", "de"].indexOf(want) !== -1) location.replace("/" + want + "/" + location.search + location.hash);
  } catch (e) {}
</script>
)}
<script is:inline>
  document.documentElement.classList.add("js");
  try { var t = localStorage.getItem("easyshoot-theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {}
</script>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
<Chrome lang={lang} alternates={alternates}><slot /></Chrome>
<script>
  import "../scripts/site.ts";
</script>
</body>
</html>
